# Copy to backend/.env and adjust. Every value is optional.

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_UPLOAD_MB=10
MAX_ROWS=50000
MAX_COLUMNS=200
MAX_CATEGORIES=50

# JSON/NPY snapshots so datasets survive an API restart
STORAGE_DIR=storage
PERSIST_STATE=true

# Decoder defaults (the Settings page can change these at runtime)
DEFAULT_CONFIDENCE_THRESHOLD=0.75
DEFAULT_NEAR_TIE_THRESHOLD=0.05
DEFAULT_TOP_K=3
DEFAULT_MODE=strict
PROBABILITY_SUM_TOLERANCE=0.001

# Optional Gemini provider. Leave empty to run fully offline with simulated vectors.
# The key stays on the server and is never sent to the browser. You can also set (or
# change) the key and model directly from the Settings page in the UI instead of here -
# a value set there is stored in storage/gemini.json and takes precedence over this one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_ROWS=50
GEMINI_BATCH_SIZE=20
GEMINI_TIMEOUT_SECONDS=45
